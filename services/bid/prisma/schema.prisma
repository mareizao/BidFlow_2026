generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["bid"]
}

model Licitacion {
  id          String           @id @default(uuid())
  titulo      String
  cliente     String
  estado      EstadoLicitacion @default(borrador)
  fechaCierre DateTime
  createdBy   String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  tareas      Tarea[]

  @@map("licitaciones")
  @@schema("bid")
}

model Tarea {
  id             String      @id @default(uuid())
  licitacionId   String
  area           AreaTarea
  responsableId  String
  estado         EstadoTarea @default(pendiente)
  horasEstimadas Int         @default(0)
  completadaAt   DateTime?
  createdAt      DateTime    @default(now())
  licitacion     Licitacion  @relation(fields: [licitacionId], references: [id])

  @@index([licitacionId])
  @@index([responsableId])
  @@map("tareas")
  @@schema("bid")
}

enum EstadoLicitacion {
  borrador
  en_revision
  aprobada
  cerrada

  @@schema("bid")
}

enum AreaTarea {
  SME
  finanzas
  juridico

  @@schema("bid")
}

enum EstadoTarea {
  pendiente
  completada

  @@schema("bid")
}