generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["doc"]
}

model Documento {
  id           String   @id @default(uuid())
  filename     String
  storageKey   String
  fileSize     Int
  mimeType     String
  licitacionId String
  uploadedBy   String
  uploadedAt   DateTime @default(now())

  @@map("documentos")
  @@schema("doc")
}

