generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["auth"]
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  nombre    String
  rol       Rol      @default(pre_sales)
  area      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 👈 CORREGIDO: La tabla se llama "users" (minúscula, plural)
  @@map("users")
  @@schema("auth")
}

enum Rol {
  admin
  pre_sales
  sme
  finanzas
  juridico
  
  @@schema("auth")
}