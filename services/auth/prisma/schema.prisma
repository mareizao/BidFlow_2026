generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]  // ← OBLIGATORIO
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["auth"]  // ← Buscar en schema auth
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  nombre    String
  rol       Rol      @default(pre_sales)
  area      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
  @@schema("auth")  // ← Tabla está en auth
}

enum Rol {
  admin
  pre_sales
  sme
  finanzas
  juridico
  
  @@schema("auth")
}